# A read-only connection to the Work Health CoLab database: the role
# resources_reader, which can only read the public_resources view.
DATABASE_URL=postgresql://resources_reader:PASSWORD@HOST/neondb?sslmode=require

# The admin portal at /admin (optional). It's off, and /admin answers "not
# found", unless ADMIN_ENABLED is "true" and both values below are set.
ADMIN_ENABLED=false
# The one password for the portal: at least 12 characters, long and random.
ADMIN_PASSWORD=
# A connection as the role resources_admin, which can change resources (and
# nothing else in the database).
ADMIN_DATABASE_URL=
