{
  "name": "workhealthcolab-resources",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && react-router build",
    "dev": "prisma generate && node --env-file-if-exists=.env.local node_modules/.bin/react-router dev",
    "start": "node --env-file-if-exists=.env.local node_modules/.bin/react-router-serve ./build/server/index.js",
    "typecheck": "prisma generate && react-router typegen && tsc"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "isbot": "^5.1.36",
    "lucide-react": "^1.57.0",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@react-router/fs-routes": "^8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
